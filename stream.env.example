# Yayın adreslerini düzenleyin. Bu dosyayı stream.env adıyla kullanın.
INPUT="rtmp://your-input-host.example/live/your-input-key"

# Hedefleri FFmpeg tee biçiminde yazın.
OUTPUT_1="[f=flv]rtmp://your-platform.example/app/your-stream-key"
OUTPUT_2="[f=flv]rtmps://your-second-platform.example/app/your-stream-key"
OUTPUTS="${OUTPUT_1}|${OUTPUT_2}"

FPS=60
BITRATE=2500k
PRESET=veryfast
TRANSCODE=0
