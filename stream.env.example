# Copy this file to stream.env and replace every placeholder before starting.
INPUT="rtmp://your-input-host.example/live/your-input-key"

# Pipe-delimited FFmpeg tee outputs. Put each destination URL and key here.
OUTPUTS="[f=flv]rtmp://srs:1935/live/your-stream|[f=flv]rtmp://your-platform.example/app/your-stream-key"

FPS=30
BITRATE=2500k
PRESET=veryfast
TRANSCODE=0
